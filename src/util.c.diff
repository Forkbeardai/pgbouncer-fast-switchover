+PgPool *get_global_writer(PgPool *pool)
+{
+	if (!pool)
+		return NULL;
+
+	if (pool->global_writer)
+		return pool->global_writer;
+
+	if (!pool->parent_pool)
+		return NULL;
+
+	return pool->parent_pool->global_writer;
