+
+void clear_global_writer(PgPool *pool)
+{
+	if (pool->global_writer) {
+		pool->global_writer = NULL;
+		return;
+	}
+
+	if (!pool->parent_pool)
+		return;
+
+	pool->parent_pool->global_writer = NULL;
+}
