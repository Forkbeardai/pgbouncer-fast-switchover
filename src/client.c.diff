+/*
+ * fast-switchover: move an already-authenticated client to another pool.
+ * Replaces the set_pool(..., takeover=true) path removed in pgbouncer 1.26.
+ */
+bool switchover_set_pool(PgSocket *client, const char *dbname)
+{
+	PgDatabase *db = find_database(dbname);
+	PgCredentials *creds;
+	PgPool *pool;
+
+	if (!db || !client->login_user_credentials)
+		return false;
+	creds = db->forced_user_credentials ? db->forced_user_credentials : client->login_user_credentials;
+	pool = get_pool(db, creds);
+	if (!pool)
+		return false;
+	/* disconnect_client() decrements client->db, so move the count with the client */
+	if (client->db != db && client->contributes_db_client_count) {
+		client->db->client_connection_count--;
+		db->client_connection_count++;
+	}
+	client->db = db;
+	client->pool = pool;
+	return true;
+}
